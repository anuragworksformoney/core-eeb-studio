rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (request.auth.token.email == 'anurag.tiwari@universal.edu.in' && request.auth.token.email_verified == true)
        || (request.auth.token.email == 'connect@corewebstudio.in' && request.auth.token.email_verified == true)
        || (request.auth.token.email == 'hello@corewebstudio.in' && request.auth.token.email_verified == true)
        || request.auth.token.admin == true
      );
    }

    // 1. Contact Submissions Collection
    match /contact_submissions/{submissionId} {
      // Preserve existing public visitor write permissions for contact form & modal
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.status == 'NEW'
                    && (
                      (request.resource.data.email is string && request.resource.data.email.size() >= 3)
                      || (request.resource.data.phone is string && request.resource.data.phone.size() >= 5)
                    );

      // Protect client inquiries: strictly private to authorized administrators
      allow read, update, delete: if isAdmin();
    }

    // 2. Client Projects Collection
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }

    // 3. Follow-up Reminders Collection
    match /follow_ups/{followUpId} {
      allow read, write: if isAdmin();
    }

    // 4. Admin Users Collection
    match /admins/{adminId} {
      // Authenticated users can check if their own UID is registered as an admin
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list, write: if isAdmin();
    }

    // Default deny catch-all for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
